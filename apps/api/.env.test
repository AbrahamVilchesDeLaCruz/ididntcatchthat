# ─── E2E Test Environment ─────────────────────────────────────────────────────
# Used by jest.e2e.config.ts via dotenv setupFiles.
# These are FAKE values — safe for local test runs and CI.
# Google OAuth is not tested in E2E (redirect flow) — dummy values are fine.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3000

# Matches docker-compose.test.yml postgres service (port 5433 locally)
DATABASE_URL=postgres://test:test@localhost:5433/ididntcatchthat_test

# Fake secret — only needs to be a non-empty string for JWT signing in tests
JWT_SECRET=test-jwt-secret-not-for-production

# Google OAuth — not exercised in E2E tests (callback flow requires browser)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

CORS_ORIGIN=http://localhost:5173
