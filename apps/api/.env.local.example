# ─── Local profile (no Doppler) ─────────────────────────────────────────────
# Copy to .env.local: cp .env.local.example .env.local
# Requires: make local-up (Postgres + RabbitMQ + MinIO)

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://local:local@localhost:5434/ididntcatchthat_local
AMQP_URI=amqp://local:local@localhost:5674

USE_STUB_ADAPTERS=true

JWT_SECRET=local-dev-jwt-secret-minimum-32-chars!!
JWT_EXPIRES_IN=15m

# OAuth dummy — email/password login works; Google OAuth will fail locally
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Stub keys (Joi requires presence; not used when USE_STUB_ADAPTERS=true)
DEEPSEEK_API_KEY=local-stub-deepseek
ELEVEN_LABS_API_KEY=local-stub-elevenlabs
ELEVENLABS_VOICE_ID_AMERICAN=local-voice-us
ELEVENLABS_VOICE_ID_BRITISH=local-voice-uk
ELEVENLABS_VOICE_ID_AUSTRALIAN=local-voice-au

# MinIO (S3-compatible, replaces Cloudflare R2 locally)
CLOUD_STORAGE=http://localhost:9000
CLOUD_STORAGE_PUBLIC_URL=http://localhost:9000
CLOUD_STORAGE_ACCESS_KEY_ID=localminio
CLOUD_STORAGE_SECRET_ACCESS_KEY=localminio
CLOUD_STORAGE_BUCKET=idct-local

LOG_LEVEL=debug
