{
  "name": "@ididntcatchthat/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migration:run": "TS_NODE_PROJECT=tsconfig.migrations.json doppler run -- typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/typeorm.config.cli.ts migration:run",
    "migration:revert": "TS_NODE_PROJECT=tsconfig.migrations.json doppler run -- typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/typeorm.config.cli.ts migration:revert",
    "migration:show": "TS_NODE_PROJECT=tsconfig.migrations.json doppler run -- typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/typeorm.config.cli.ts migration:show",
    "seed:local": "TS_NODE_PROJECT=tsconfig.migrations.json DOTENV_CONFIG_PATH=.env.local node -r dotenv/config -r tsconfig-paths/register ./node_modules/ts-node/dist/bin.js src/shared/infrastructure/persistence/seeds/run-local-seeds.ts",
    "migration:run:local": "TS_NODE_PROJECT=tsconfig.migrations.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/infrastructure/persistence/typeorm/typeorm.config.cli.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --passWithNoTests --silent",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --watch --silent",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --coverage --passWithNoTests --silent",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.ts --runInBand --passWithNoTests --forceExit --silent",
    "test:e2e:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.ts --runInBand --watch --silent",
    "test:e2e:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.ts --runInBand --coverage --passWithNoTests --forceExit --silent",
    "test:cov:all": "rm -rf coverage && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --coverage --passWithNoTests --silent; UNIT=$?; NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.ts --runInBand --coverage --passWithNoTests --silent; E2E=$?; node scripts/merge-coverage.mjs; exit $((UNIT || E2E))",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --coverage --ci --forceExit --passWithNoTests",
    "test:e2e:ci": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.ts --runInBand --coverage --ci --forceExit --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config jest.config.ts --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.39.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
