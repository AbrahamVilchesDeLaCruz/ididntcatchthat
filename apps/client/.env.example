# Copy to .env.local: cp apps/client/.env.example apps/client/.env.local
#
# ─── Vite dev server (:5173) — RECOMMENDED ───────────────────────────────────
# Do NOT set VITE_API_URL. The client uses baseURL `/api/v1` and Vite proxies
# to the API. nginx is NOT involved (nginx only serves the Docker client :4001).
#
# API on host (make local-dev / make local-dev-api):
VITE_API_PROXY_TARGET=http://localhost:3000
# API in Docker (make up — published on host :3001):
# VITE_API_PROXY_TARGET=http://localhost:3001
#
# ─── Option B — absolute URL (bypasses Vite proxy; needs CORS on API) ───────
# VITE_API_URL=http://localhost:3000/v1
# VITE_API_URL=http://localhost:3001/v1
#
# ─── Docker client only (:4001) ──────────────────────────────────────────────
# Built with empty VITE_API_URL → relative /api/v1 → nginx → api:3000
# Open http://localhost:4001 (not :5173)
