# Copy to .env.local: cp .env.local.example .env.local
#
# Option A — relative URL + Vite proxy (recommended for local dev):
#   Leave VITE_API_URL unset; requests go to /api/v1 and Vite proxies to the API.
#   make up (Docker API on host :3001):
VITE_API_PROXY_TARGET=http://localhost:3001
#   local-dev-api (API on host :3000):
# VITE_API_PROXY_TARGET=http://localhost:3000
#
# Option B — absolute URL (bypasses Vite proxy; must include /v1):
# VITE_API_URL=http://localhost:3000/v1
# VITE_API_URL=http://localhost:3001/v1
